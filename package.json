{
  "name": "tree-sitter-cloudflare",
  "version": "0.0.1",
  "description": "Tree-sitter grammar for the Cloudflare rules language",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colinbendell/tree-sitter-cloudflare.git"
  },
  "license": "ISC",
  "author": "nfowl",
  "contributors": [
    "Colin Bendell <colin@bendell.ca>"
  ],
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "cloudflare"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.5.0",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "prebuildify": "^6.0.1",
    "tree-sitter-cli": "^0.26.11",
    "@keqingmoe/tree-sitter": "^0.26.2"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "node --test bindings/node/*_test.js"
  }
}
